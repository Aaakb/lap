<Window x:Class="MedicalLab.ResultsEntryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="إدخال نتائج التحاليل" Width="850" Height="580" MinWidth="650" MinHeight="420" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="16" Background="#F0F5F6">
 <DockPanel Margin="20"><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="PatientTitle" FontSize="21" FontWeight="Bold"/><TextBlock Text="اكتب النتيجة بجانب التحليل. يمكن ترك التحاليل غير الجاهزة فارغة." Margin="0,8" TextWrapping="Wrap"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10"><Button Content="حفظ النتائج المدخلة" Click="Save" Padding="18,10"/><Button Content="إغلاق" IsCancel="True" Margin="10,0" Padding="18,10"/></StackPanel><DataGrid x:Name="Entries" FlowDirection="LeftToRight" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="40" IsReadOnly="False"><DataGrid.Columns><DataGridTextColumn Header="Test" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Result — enter here" Binding="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Width="160"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" IsReadOnly="True" Width="170"/></DataGrid.Columns></DataGrid></DockPanel>
</Window>
