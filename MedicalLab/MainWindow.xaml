<Window x:Class="MedicalLab.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="مختبر الأصمعي — نسخة تجريبية" Width="1200" Height="780" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Background="#F0F5F6" FontFamily="Segoe UI" FontSize="15">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Clinical.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
<DockPanel Margin="20"><StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="مختبر الأصمعي" FontSize="26" FontWeight="Bold" Foreground="#15565A"/><TextBlock Text="نسخة تجريبية — القيم المعروضة للتجربة فقط ولا تستخدم لقرارات طبية" Foreground="#9B341D" FontWeight="SemiBold" Margin="0,4,0,12"/></StackPanel>
<TabControl TabStripPlacement="Right" x:Name="Tabs" SelectionChanged="TabChanged">
<TabItem Header="المرضى"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><StackPanel Width="250"><TextBlock Text="اسم المريض *"/><TextBox x:Name="NameInput"/></StackPanel><StackPanel Width="190"><TextBlock Text="تاريخ الميلاد"/><DatePicker x:Name="BirthInput" Margin="4" Padding="5"/></StackPanel><StackPanel Width="140"><TextBlock Text="الجنس"/><ComboBox x:Name="SexInput" SelectedIndex="0"><ComboBoxItem Content="غير محدد"/><ComboBoxItem Content="ذكر"/><ComboBoxItem Content="أنثى"/></ComboBox></StackPanel><Button Content="مريض جديد" Click="NewPatient" VerticalAlignment="Bottom"/><StackPanel Width="170"><TextBlock Text="بحث بالاسم أو الرقم"/><TextBox x:Name="PatientSearch" TextChanged="SearchPatients"/></StackPanel><Button Content="حفظ المريض" Click="AddPatient" VerticalAlignment="Bottom"/><Button Content="حفظ وإنشاء طلب تحاليل" Click="SavePatientAndOrder" VerticalAlignment="Bottom"/><Button Content="طلبات المريض المحدد" Click="PatientHistory"/><Button Content="إنشاء طلب للمريض المحدد" Click="SelectedPatientOrder" VerticalAlignment="Bottom"/></WrapPanel><DataGrid SelectionChanged="PatientSelected" x:Name="PatientsGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="الرقم" Binding="{Binding Id}" Width="80"/><DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="تاريخ الميلاد" Binding="{Binding BirthDate, StringFormat=yyyy-MM-dd}" Width="170"/><DataGridTextColumn Header="الجنس" Binding="{Binding Sex}" Width="130"/></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem Header="التحاليل والقيم"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="كل صف يمثل نطاقاً واحداً. حدد صفاً لتعديله أو تعطيله. العمر بالسنوات الكاملة." TextWrapping="Wrap"/>
<ScrollViewer Grid.Row="1" MaxHeight="250" VerticalScrollBarVisibility="Auto"><WrapPanel  Margin="0,8"><StackPanel Width="190"><TextBlock Text="اسم التحليل"/><TextBox x:Name="TestName" FlowDirection="LeftToRight"/></StackPanel><StackPanel Width="115"><TextBlock Text="نوع النتيجة"/><ComboBox x:Name="ResultKind" SelectedIndex="0" SelectionChanged="ResultKindChanged"><ComboBoxItem Content="رقمية"/><ComboBoxItem Content="نصية"/></ComboBox></StackPanel><StackPanel Width="140"><TextBlock Text="المرجع النصي"/><TextBox x:Name="ExpectedTextInput" FlowDirection="LeftToRight" IsEnabled="False"/></StackPanel><StackPanel Width="90"><TextBlock Text="الوحدة"/><TextBox x:Name="UnitInput" FlowDirection="LeftToRight"/></StackPanel><StackPanel Width="75"><TextBlock Text="من عمر"/><TextBox x:Name="MinAge"/></StackPanel><StackPanel Width="75"><TextBlock Text="إلى عمر"/><TextBox x:Name="MaxAge"/></StackPanel><StackPanel Width="105"><TextBlock Text="الجنس"/><ComboBox x:Name="RangeSex" SelectedIndex="0"><ComboBoxItem Content="الكل"/><ComboBoxItem Content="ذكر"/><ComboBoxItem Content="أنثى"/></ComboBox></StackPanel><StackPanel Width="90"><TextBlock Text="الحد الأدنى"/><TextBox x:Name="LowInput"/></StackPanel><StackPanel Width="90"><TextBlock Text="الحد الأعلى"/><TextBox x:Name="HighInput"/></StackPanel><Button Content="جديد" Click="ClearTest" VerticalAlignment="Bottom"/><Button Content="حفظ" Click="SaveTest" VerticalAlignment="Bottom"/><Button Content="تعطيل / تفعيل" Click="ToggleTest" VerticalAlignment="Bottom"/></WrapPanel></ScrollViewer>
<DataGrid FlowDirection="LeftToRight" x:Name="TestsGrid" Grid.Row="2" SelectionChanged="TestSelected"><DataGrid.Columns><DataGridTextColumn Header="Test" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="100"/><DataGridTextColumn Header="من عمر" Binding="{Binding MinAge}" Width="75"/><DataGridTextColumn Header="إلى عمر" Binding="{Binding MaxAge}" Width="75"/><DataGridTextColumn Header="الجنس" Binding="{Binding Sex}" Width="90"/><DataGridTextColumn Header="الأدنى" Binding="{Binding Low}" Width="90"/><DataGridTextColumn Header="الأعلى" Binding="{Binding High}" Width="90"/><DataGridCheckBoxColumn Header="نصي" Binding="{Binding IsText}" Width="60"/><DataGridTextColumn Header="مرجع نصي" Binding="{Binding ExpectedText}" Width="120"/><DataGridCheckBoxColumn Header="مفعل" Binding="{Binding Active}" Width="75"/></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem x:Name="ResultsTab" Header="النتائج والتقارير"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="١. اختر المريض وأنشئ طلباً.  ٢. اختر التحليل وأضفه للطلب أو أضف مجموعة.  ٣. أدخل نتائج التحاليل المنتظرة ثم اعتمد الطلب." TextWrapping="Wrap"/>
<ScrollViewer Grid.Row="1" MaxHeight="250" VerticalScrollBarVisibility="Auto"><WrapPanel  Margin="0,10"><StackPanel Width="220"><TextBlock Text="المريض"/><ComboBox x:Name="PatientChoice" DisplayMemberPath="Name"/></StackPanel><StackPanel Width="270"><TextBlock Text="الطلب"/><ComboBox x:Name="OrderChoice" DisplayMemberPath="Label" SelectionChanged="OrderChanged"/></StackPanel><Button Content="إنشاء طلب للمريض" Click="NewOrder" VerticalAlignment="Bottom"/><StackPanel Width="220"><TextBlock Text="التحليل"/><ComboBox x:Name="TestChoice" FlowDirection="LeftToRight" SelectionChanged="UpdateResultDetails"/></StackPanel><StackPanel Width="140"><TextBlock Text="أدخل النتيجة"/><TextBox x:Name="ValueInput" FlowDirection="LeftToRight"/></StackPanel><StackPanel Width="210"><TextBlock Text="مجموعة التحاليل"/><ComboBox x:Name="PanelChoice" DisplayMemberPath="Name"/></StackPanel><Button Content="اختيار عدة تحاليل" Click="ChooseTests"/><Button Content="إضافة التحليل للطلب" Click="PlanSelectedTest"/><Button Content="إضافة المجموعة للطلب" Click="ApplyPanel"/><Button Content="اعتماد الطلب" Click="ApproveOrder"/><Button Content="إعادة فتح للتصحيح" Click="ReopenOrder"/><Button Content="حذف نتيجة من المسودة" Click="DeleteResult"/><Button Content="حفظ النتيجة" Click="SaveResult" VerticalAlignment="Bottom"/><Button Content="حفظ PDF مباشر" Click="ExportPdf"/><Button Content="طباعة الطلب" Click="PrintResult" VerticalAlignment="Bottom"/></WrapPanel></ScrollViewer>
<DockPanel Grid.Row="2"><StackPanel DockPanel.Dock="Top"><WrapPanel><ComboBox x:Name="PendingChoice" Width="220" FlowDirection="LeftToRight" SelectionChanged="PendingSelected"/><Button Content="إزالة تحليل منتظر من المسودة" Click="RemovePending"/></WrapPanel><TextBlock x:Name="PendingText" TextWrapping="Wrap" Foreground="#8A4512"/><TextBlock Text="اختر تحليلاً من الجدول لإدخال نتيجته" FontWeight="SemiBold"/><DataGrid x:Name="PendingGrid" Height="130" SelectionChanged="PendingRowSelected" FlowDirection="LeftToRight" Margin="4"><DataGrid.Columns><DataGridTextColumn Header="Test" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="100"/><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="160"/></DataGrid.Columns></DataGrid><TextBlock x:Name="ResultDetails" Text="اختر طلباً وتحليلاً لعرض نوع النتيجة والمرجع." TextWrapping="Wrap" FlowDirection="LeftToRight" FontSize="15" Margin="8"/></StackPanel><DataGrid FlowDirection="LeftToRight" x:Name="ResultsGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="200"/><DataGridTextColumn Header="Result" Binding="{Binding ValueDisplay}" Width="85"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="110"/><DataGridTextColumn Header="Reference" Binding="{Binding ReferenceDisplay}" Width="140"/><DataGridTextColumn Header="Flag" Binding="{Binding FlagDisplay}" Width="150"/><DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/><DataGridTextColumn Header="المريض" Binding="{Binding PatientName}" Width="180" ElementStyle="{StaticResource ArabicCell}"/></DataGrid.Columns></DataGrid></DockPanel></Grid></TabItem>
<TabItem Header="الإعدادات والنسخ"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="650" HorizontalAlignment="Stretch"><TextBlock Text="بيانات المختبر في التقرير" FontWeight="Bold" FontSize="20" Margin="0,0,0,16"/><TextBlock Text="اسم المختبر"/><TextBox x:Name="LabNameInput"/><TextBlock Text="العنوان"/><TextBox x:Name="LabAddressInput"/><TextBlock Text="رقم الهاتف"/><TextBox x:Name="LabPhoneInput"/><TextBlock Text="شعار المختبر"/><TextBlock x:Name="LogoStatus" Text="لا يوجد شعار"/><WrapPanel><Button Content="اختيار شعار" Click="ChooseLogo"/><Button Content="إزالة الشعار" Click="RemoveLogo"/></WrapPanel><Button Content="حفظ بيانات المختبر" Click="SaveSettings"/><Separator Margin="0,20"/><TextBlock Text="النسخ الاحتياطي والاستعادة" FontWeight="Bold" FontSize="20"/><TextBlock Text="تشمل النسخة المرضى والتحاليل والنتائج والطلبات وبيانات المختبر. تحفظ نسخة من البيانات الحالية تلقائياً قبل الاستعادة." TextWrapping="Wrap" Margin="0,12"/><Button Content="إنشاء نسخة احتياطية" Click="CreateBackup"/><Button Content="استعادة نسخة احتياطية" Click="RestoreBackup"/></StackPanel></ScrollViewer></TabItem><TabItem Header="مجموعات التحاليل"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="8"><TextBlock Text="اسم المجموعة"/><TextBox x:Name="PanelNameInput"/><TextBlock Text="أسماء التحاليل، كل تحليل في سطر"/><TextBox x:Name="PanelTestsInput" FlowDirection="LeftToRight" AcceptsReturn="True" Height="220" VerticalScrollBarVisibility="Auto"/><TextBlock Text="استخدم أسماء التحاليل كما هي في قائمة التحاليل الفعالة." TextWrapping="Wrap"/><WrapPanel><Button Content="جديدة" Click="NewPanel"/><Button Content="حفظ المجموعة" Click="SavePanel"/><Button Content="حذف المجموعة" Click="DeletePanel"/></WrapPanel></StackPanel><DataGrid Grid.Column="1" x:Name="PanelsGrid" SelectionChanged="PanelSelected"><DataGrid.Columns><DataGridTextColumn Header="المجموعة" Binding="{Binding Name}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem Header="سجل العمليات"><DataGrid x:Name="AuditGrid"><DataGrid.Columns><DataGridTextColumn Header="الوقت" Binding="{Binding At, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="180"/><DataGridTextColumn Header="رقم الطلب" Binding="{Binding OrderId}" Width="100"/><DataGridTextColumn Header="العملية" Binding="{Binding Action}" Width="*"/></DataGrid.Columns></DataGrid></TabItem></TabControl></DockPanel></Window>
