<Window x:Class="MedicalLab.DeletePatientsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="حذف المراجعين" Width="600" Height="640" MinWidth="470" MinHeight="450" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="16">
 <DockPanel Margin="20"><StackPanel DockPanel.Dock="Top"><TextBlock Text="اختيار المراجعين للحذف" FontSize="22" FontWeight="Bold"/><TextBlock Text="سيُحذف سجل المراجع وطلباته ونتائجه. تحديد الكل يشمل كل المراجعين حتى المخفيين بالبحث." TextWrapping="Wrap" Margin="0,8"/><TextBox x:Name="Search" TextChanged="SearchChanged" Padding="8"/><WrapPanel><Button Content="تحديد الكل" Click="SelectAll" Padding="10"/><Button Content="إلغاء تحديد الكل" Click="ClearAll" Padding="10" Margin="8,0"/></WrapPanel><TextBlock x:Name="CountLabel" Margin="0,8"/></StackPanel><Button DockPanel.Dock="Bottom" Content="حذف المحددين" Click="Delete" Padding="12" Background="#A32F22" Foreground="White"/><ListBox x:Name="PatientList" Margin="0,12" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Padding="8"><TextBlock><Run Text="{Binding Name}"/><Run Text=" — #"/><Run Text="{Binding Id}"/></TextBlock></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
</Window>
