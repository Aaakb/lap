<Window x:Class="MedicalLab.PatientVisitsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سجل الزيارات" Width="560" Height="470" MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="Segoe UI" FontSize="16" Background="#F0F5F6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PatientHeading" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
        <ListBox x:Name="Visits" Grid.Row="1" Margin="0,12" SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="8,6">
                        <TextBlock Text="زيارة" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding PatientOrderNumber}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd}"
                                   FlowDirection="LeftToRight" Margin="24,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="عرض نتائج الزيارة" IsDefault="True" Padding="14,7" Click="OpenVisit"/>
            <Button Content="إغلاق" IsCancel="True" Padding="14,7" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
