<Window x:Class="MedicalLab.SelectPatientsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="اختيار المراجعين" Width="580" Height="600" MinWidth="450" MinHeight="400" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="16">
 <DockPanel Margin="20"><StackPanel DockPanel.Dock="Top"><TextBlock Text="اختر المراجعين للتصدير" FontSize="22" FontWeight="Bold"/><TextBlock Text="ابحث بالاسم أو الرقم، وضع علامة بجانب كل مراجع." Margin="0,8"/><TextBox x:Name="Search" TextChanged="SearchChanged" Padding="8"/></StackPanel><Button DockPanel.Dock="Bottom" Content="تصدير السجلات المحددة" Click="Accept" Padding="12"/><ListBox x:Name="PatientList" Margin="0,12" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}" Padding="8"><TextBlock><Run Text="{Binding Name}"/><Run Text=" — #"/><Run Text="{Binding Id}"/></TextBlock></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
</Window>
